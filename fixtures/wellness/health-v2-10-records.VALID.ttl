    cascade:dataProvenance cascade:DeviceGenerated .

<urn:uuid:0b7a1c00-0010-4000-8000-000000000009> a health:Device ;
    health:deviceName "Apple Watch" ;
    health:deviceModel "Watch" ;
    health:hardwareVersion "Watch3,3" ;
    health:deviceManufacturer "Apple Inc." ;
    health:softwareVersion "6.2" ;
    cascade:dataProvenance cascade:DeviceGenerated .
